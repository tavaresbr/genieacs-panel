# App Configuration
APP_PORT=5890
PORTAL_PORT=5891
APP_HOST=127.0.0.1
APP_ENV=production

# Security (REQUIRED — generated automatically by install.sh)
JWT_SECRET=change_me_to_a_long_random_string
PORTAL_JWT_SECRET=change_me_to_an_independent_long_random_string
# Encrypts the secrets an operator can read back: customer portal passwords,
# saved WiFi passwords, provisioning profile passwords, the SGP and WhatsApp
# tokens. Falls back to JWT_SECRET when unset, which is how installs predating
# this variable keep working.
#
# Set it, and rotating JWT_SECRET no longer destroys that stored data: each
# secret records which key encrypted it, so both are readable side by side.
# Anything written before this key was configured stays tied to JWT_SECRET
# until it is written again.
SECRET_BOX_KEY=change_me_to_an_independent_long_random_string

# The read-side window that makes a rotation survivable. Set the value being
# replaced here, change the live one, and every stored secret stays readable
# until it is next written: the live key writes, the previous one is only ever
# tried on the way in. Clear it once everything has been rewritten -- leaving it
# set keeps the old key usable, which is the point during a rotation, not after.
# JWT_SECRET_PREVIOUS=
# SECRET_BOX_KEY_PREVIOUS=

# Edition: 'selfhosted' (default) is one install for one provider. 'saas' is a
# deployment serving many providers; it withdraws the runtime database
# switcher, which wipes the target before copying and would therefore destroy
# every provider's data at once.
# EDITION=selfhosted

# Exigir e-mail no login, desligando o nome de usuário.
#
# O painel já aceita os dois: toda conta nova nasce com e-mail, e quem já usava
# cadastra o dele em Configurações. Esta chave é o ÚLTIMO passo da troca, e é
# de mão única — com ela ligada, uma conta sem e-mail não entra por nada, e não
# há tela para desfazer.
#
# Antes de ligar, veja quantas contas ainda estão sem endereço: a tela de
# operadores mostra, e `GET /api/auth/email-readiness` responde o número. Ligar
# com esse número acima de zero é trancar essa gente do lado de fora —
# inclusive quem cadastraria o e-mail dos outros.
# LOGIN_REQUIRES_EMAIL=false
JWT_EXPIRES_IN=1h
REFRESH_TOKEN_EXPIRES_IN=7d

# Trust the reverse proxy / Cloudflare Tunnel in front of the panel.
# 1 = trust one hop (correct whenever APP_HOST stays on 127.0.0.1). Without it
# every customer shares one rate-limit bucket and portal cookies lose Secure.
# 0 = trust nothing; required when the listeners are exposed directly.
TRUST_PROXY=1

# Portal cookie Secure flag: auto (follow the request), true, or false.
# PORTAL_COOKIE_SECURE=auto

# CORS: only needed when frontend is served from a different origin.
# Single-service mode serves the UI and API on the same port, so leave default.
CORS_ORIGINS=http://localhost:5890

# Data directory (SQLite file + db-config.json live here).
# DATA_DIR=/var/lib/skygenpanel

# Database is configured at runtime via the Setup wizard / Settings > Database.
# Defaults to SQLite (no external DB required). To pin MySQL via env instead of
# the UI, the panel reads DATA_DIR/db-config.json which the UI writes.

# ── Multi-provider (hosted edition) ──────────────────────────────────────────

# The domain the panel and the subscriber portal hang off, when each provider
# gets its own subdomain: alfa.painel.exemplo.com resolves to the provider whose
# slug is "alfa". Setting either turns host resolution ON, and with it on a
# subdomain that names nobody is a 404 rather than "the first provider".
# Leave both unset for a single-provider install.
# TENANT_BASE_DOMAIN=painel.exemplo.com
# PORTAL_BASE_DOMAIN=portal.exemplo.com

# ── GenieACS egress ──────────────────────────────────────────────────────────

# Extra ports a provider's NBI may be reached on, beyond 80, 443, 7557 and 8080.
# The list exists because a base URL that is customer-supplied data is also a
# port scanner: the panel reports "connected" or "refused" for whatever it is
# pointed at. Widen it only for ports your own network can tolerate being
# probed on. Ignored on the self-hosted edition, where there is no untrusted
# party. Comma separated.
# GENIEACS_ALLOWED_PORTS=8443,9090

# How many ACS requests may be in flight at once, in total and per provider.
# The per-provider ceiling is what stops one ISP's slow ACS from queueing the
# whole panel behind it; the global one keeps sockets and heap bounded.
# GENIEACS_MAX_CONCURRENCY=32
# GENIEACS_MAX_CONCURRENCY_PER_TENANT=6

# --- Hosted edition and operations (all optional) ---------------------------
# EDITION=saas
# Providers by subdomain: <slug>.TENANT_BASE_DOMAIN and <slug>.PORTAL_BASE_DOMAIN.
# TENANT_BASE_DOMAIN=painel.exemplo.com
# PORTAL_BASE_DOMAIN=portal.exemplo.com
# The database as a URL; wins over data/db-config.json when both exist.
# DATABASE_URL=postgres://user:pass@host:5432/db?schema=panel&sslmode=require
# One line per event, with the provider on every line: text (default) or json.
# LOG_FORMAT=json
# LOG_LEVEL=info
# Lets a scraper read /api/platform/metrics without a session (32+ chars).
# METRICS_TOKEN=
# The credential the payment gateway sends back on every webhook delivery, in
# the `asaas-access-token` header. It is the deployment's, not a provider's:
# there is one account at the gateway and it is ours, which is why this is an
# environment variable and not a per-provider secret in the database.
#
# Without it the webhook route answers 404 rather than accepting anything — a
# route that moves money must not be open because somebody forgot a variable.
# Paste here the same value typed into the gateway's webhook settings.
# BILLING_WEBHOOK_TOKEN=
# And the key the panel uses to CALL the gateway, to create a charge. A different
# credential from the one above, travelling in the other direction and in a
# different header (`access_token` out, `asaas-access-token` in) — confusing them
# gives a 401 only on the side that is exercised by charging for real.
#
# Without it nothing is issued and every provider stays on manual billing. It is
# per deployment, like the one above: there is one account at the gateway, ours.
# ASAAS_API_KEY=
# The gateway's API base. Production by default; point it at the sandbox
# (https://api-sandbox.asaas.com/v3) while testing, with a sandbox key.
# ASAAS_BASE_URL=https://api.asaas.com/v3

# --- Invite email (optional; without it the invite link comes back in the API
# --- response and is handed over by whoever invited)
# SMTP_URL=smtps://user:password@smtp.example.com:465
# MAIL_FROM=SkyGenPanel <no-reply@example.com>
# The panel's external address, for links inside a message. Only needed where
# providers are NOT reached by subdomain; with TENANT_BASE_DOMAIN set, each
# provider's address is derived from its slug.
# PUBLIC_BASE_URL=https://panel.example.com

# ── Row Level Security (só PostgreSQL) ───────────────────────────────────────

# Segunda linha de isolamento, DESLIGADA por padrão.
#
# O painel já filtra por provedor em `tdb()` e tem uma sentinela que lança em
# teste ao ver tabela escopada sem filtro. As duas agem onde o erro é escrito.
# O RLS pega o que elas não pegam — SQL cru fora do processo, ou um defeito do
# knex — porque age no banco.
#
# O preço, medido num Postgres 16 local: a consulta passa de 0,258 ms para
# 0,649 ms (+152%), porque cada uma passa a ser uma transação com `set_config`.
# É a única forma segura com pool: o contexto do provedor tem que ser capturado
# na CONSTRUÇÃO da consulta, e marcar a variável na conexão deixa a marca lá
# para a próxima requisição que pegar aquela conexão emprestada.
#
# ATENÇÃO: conecte com um papel que NÃO seja superusuário nem tenha BYPASSRLS.
# Um papel desses ignora a política mesmo com FORCE, e o painel se recusa a
# subir em vez de fingir que está protegido.
# RLS_ENABLED=false
