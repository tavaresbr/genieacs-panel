.git
.github
node_modules
*/node_modules
backend/data
backend/test
backend/coverage
frontend/dist
docs/screenshots
deploy
# O instalador do agente é conteúdo que o painel SERVE, não ferramenta de
# deploy: o Dockerfile o copia para /app/deploy/, e sem esta exceção a rota
# responderia 404 na imagem.
!deploy/install-agent.sh
scripts
*.md
!README.md
# Patterns here match from the context root, so `.env` alone left
# `backend/.env` -- the file the backend actually loads -- to be copied into
# the image by `COPY backend/ ./`, with every secret in it.
**/.env
**/*.env
**/.env.*
!**/.env.example
**/*.db
**/*.sqlite
**/*.sqlite3
**/*.sqlite-*
