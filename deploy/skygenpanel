#!/usr/bin/env bash
#
# skygenpanel — management CLI for the TR69 Controle service.
#
set -euo pipefail

INSTALL_DIR="${SKYGP_DIR:-/opt/skygenpanel}"
SERVICE_NAME="skygenpanel"
ENV_FILE="${INSTALL_DIR}/backend/.env"
REPO_BRANCH="${SKYGP_BRANCH:-main}"
CLI_PATH="${SKYGP_CLI_PATH:-/usr/local/bin/skygenpanel}"
BACKUP_CLI_PATH="${SKYGP_BACKUP_CLI_PATH:-/usr/local/bin/skygenpanel-backup}"
AUTOUPDATE_CLI_PATH="${SKYGP_AUTOUPDATE_CLI_PATH:-/usr/local/bin/skygenpanel-autoupdate}"
UPDATE_LOCK="${SKYGP_UPDATE_LOCK:-/run/skygenpanel-update.lock}"
NODE_MAJOR_MIN=22
NODE_MINOR_MIN=22

log()  { printf '\033[1;34m[skygp]\033[0m %s\n' "$*"; }
warn() { printf '\033[1;33m[skygp]\033[0m %s\n' "$*" >&2; }
die()  { printf '\033[1;31m[skygp]\033[0m %s\n' "$*" >&2; exit 1; }

need_root() { [ "$(id -u)" -eq 0 ] || die "This command needs root (use sudo)."; }

validate_install_dir() {
  local resolved
  [[ "$INSTALL_DIR" = /* ]] || die "Install directory must be an absolute path: $INSTALL_DIR"
  resolved="$(realpath -m -- "$INSTALL_DIR")" || die "Unable to resolve install directory: $INSTALL_DIR"
  [ "$resolved" = "$INSTALL_DIR" ] || die "Install directory must be normalized and contain no symbolic-link components: $INSTALL_DIR"
  case "$INSTALL_DIR" in
    /|/bin|/boot|/dev|/etc|/home|/lib|/lib64|/opt|/proc|/root|/run|/sbin|/srv|/sys|/tmp|/usr|/var|/var/lib)
      die "Refusing unsafe install directory: $INSTALL_DIR"
      ;;
  esac
  [[ "$INSTALL_DIR" =~ ^/[A-Za-z0-9._/-]+$ ]] || die "Install directory contains unsupported characters: $INSTALL_DIR"
  [ ! -L "$INSTALL_DIR" ] || die "Install directory must not be a symbolic link."
  [ ! -L "$ENV_FILE" ] || die "Refusing symbolic-link env file: $ENV_FILE"
}

app_port() {
  local p
  p="$(grep -E '^APP_PORT=' "$ENV_FILE" 2>/dev/null | head -1 | cut -d= -f2)"
  echo "${p:-5890}"
}

portal_port() {
  local p
  p="$(grep -E '^PORTAL_PORT=' "$ENV_FILE" 2>/dev/null | head -1 | cut -d= -f2)"
  echo "${p:-5891}"
}

data_dir() {
  local p
  p="$(grep -E '^DATA_DIR=' "$ENV_FILE" 2>/dev/null | head -1 | cut -d= -f2-)"
  echo "${p:-/var/lib/skygenpanel}"
}

node_runtime_ready() {
  local major minor resolved_node
  command -v node >/dev/null 2>&1 || return 1
  command -v npm >/dev/null 2>&1 || return 1
  resolved_node="$(realpath "$(command -v node)" 2>/dev/null || true)"
  case "$resolved_node" in
    /home/*|/root/*|'') return 1 ;;
  esac
  major="$(node -p 'process.versions.node.split(".")[0]' 2>/dev/null || true)"
  minor="$(node -p 'process.versions.node.split(".")[1]' 2>/dev/null || true)"
  [[ "$major" =~ ^[0-9]+$ ]] && [[ "$minor" =~ ^[0-9]+$ ]] \
    && { [ "$major" -gt "$NODE_MAJOR_MIN" ] \
      || { [ "$major" -eq "$NODE_MAJOR_MIN" ] && [ "$minor" -ge "$NODE_MINOR_MIN" ]; }; }
}

ensure_env_defaults() {
  [ -f "$ENV_FILE" ] || die "Env file not found: $ENV_FILE"
  if ! grep -qE '^PORTAL_PORT=' "$ENV_FILE"; then
    printf 'PORTAL_PORT=5891\n' >> "$ENV_FILE"
  fi
  if ! grep -qE '^PORTAL_JWT_SECRET=' "$ENV_FILE"; then
    printf 'PORTAL_JWT_SECRET=%s\n' \
      "$(node -e 'console.log(require("crypto").randomBytes(48).toString("hex"))')" >> "$ENV_FILE"
  fi
  if ! grep -qE '^TRUST_PROXY=' "$ENV_FILE"; then
    if grep -qE '^APP_HOST=127\.0\.0\.1$' "$ENV_FILE"; then
      printf 'TRUST_PROXY=1\n' >> "$ENV_FILE"
    else
      printf 'TRUST_PROXY=0\n' >> "$ENV_FILE"
    fi
  fi
}

set_env() {
  # set_env KEY VALUE — upsert a key in the env file
  local key="$1" value="$2"
  [ -f "$ENV_FILE" ] || die "Env file not found: $ENV_FILE"
  if grep -qE "^${key}=" "$ENV_FILE"; then
    sed -i "s|^${key}=.*|${key}=${value}|" "$ENV_FILE"
  else
    echo "${key}=${value}" >> "$ENV_FILE"
  fi
}

# Waits for the panel and the customer portal to answer their health checks.
# A restart that "succeeded" says only that systemd started a process; this is
# the panel actually serving, with its database reachable.
wait_healthy() {
  local tries=40
  while [ "$tries" -gt 0 ]; do
    if node -e "Promise.all([
        fetch('http://127.0.0.1:$(app_port)/api/health'),
        fetch('http://127.0.0.1:$(portal_port)/api/health')
      ]).then((r) => process.exit(r.every((x) => x.ok) ? 0 : 1)).catch(() => process.exit(1))" 2>/dev/null; then
      return 0
    fi
    tries=$((tries - 1))
    sleep 3
  done
  return 1
}

# update [TARGET]
#   no TARGET   the tip of $REPO_BRANCH, as it always was
#   vX.Y.Z      that published release (what skygenpanel-autoupdate asks for)
#   <full sha>  a commit already in this checkout (how a rollback goes back)
cmd_update() {
  local target="${1:-}" legacy_dir cli_temp repo_url active_data_dir active_app_port active_portal_port
  need_root
  validate_install_dir
  [ -d "$INSTALL_DIR/.git" ] || die "Not a git checkout: $INSTALL_DIR"
  # The automatic updater holds this lock already and says so; anyone else
  # takes it, so a manual update and a scheduled one never run on top of
  # each other.
  if [ -z "${SKYGP_UPDATE_LOCK_HELD:-}" ]; then
    exec 9>"$UPDATE_LOCK"
    flock -n 9 || die "Another update is running. Try again when it finishes."
  fi
  if [ -z "$target" ]; then
    log "Fetching latest ($REPO_BRANCH)"
    git -C "$INSTALL_DIR" fetch --depth 1 origin "$REPO_BRANCH"
    git -C "$INSTALL_DIR" reset --hard "origin/$REPO_BRANCH"
  elif [[ "$target" =~ ^v[0-9]+\.[0-9]+\.[0-9]+$ ]]; then
    log "Fetching release $target"
    git -C "$INSTALL_DIR" fetch --depth 1 --force origin "+refs/tags/${target}:refs/tags/${target}"
    git -C "$INSTALL_DIR" reset --hard "${target}^{commit}"
  elif [[ "$target" =~ ^[0-9a-f]{40}$ ]]; then
    git -C "$INSTALL_DIR" cat-file -e "${target}^{commit}" 2>/dev/null \
      || die "Commit $target is not in this checkout."
    log "Returning to ${target:0:12}"
    git -C "$INSTALL_DIR" reset --hard "$target"
  else
    die "Unknown update target: $target (expected vX.Y.Z or a full commit hash)."
  fi
  if ! node_runtime_ready; then
    # The runtime installer re-fetches $REPO_BRANCH, which would silently
    # replace the release asked for with the tip of the branch.
    [ -z "$target" ] \
      || die "Node.js 22.22 or newer is required first. Run 'skygenpanel update' by hand to install it."
    repo_url="$(git -C "$INSTALL_DIR" remote get-url origin)"
    active_data_dir="$(data_dir)"
    active_app_port="$(app_port)"
    active_portal_port="$(portal_port)"
    log "Node.js 22.22 or newer is required; handing off to the automatic runtime installer."
    SKYGP_REPO="$repo_url" \
      SKYGP_BRANCH="$REPO_BRANCH" \
      SKYGP_DIR="$INSTALL_DIR" \
      SKYGP_DATA="$active_data_dir" \
      SKYGP_PORT="$active_app_port" \
      SKYGP_PORTAL_PORT="$active_portal_port" \
      bash "$INSTALL_DIR/deploy/install.sh"
    return
  fi
  log "Removing legacy Next.js build artifacts"
  for legacy_dir in "$INSTALL_DIR/frontend/.next" "$INSTALL_DIR/frontend/out"; do
    [ ! -L "$legacy_dir" ] || die "Refusing symbolic-link legacy artifact: $legacy_dir"
    if [ -e "$legacy_dir" ]; then
      rm -rf -- "$legacy_dir"
    fi
  done
  [ ! -L "$CLI_PATH" ] || die "Refusing symbolic-link CLI path: $CLI_PATH"
  cli_temp="${CLI_PATH}.new.$$"
  trap 'rm -f -- "${cli_temp:-}"' EXIT
  install -m 0755 "$INSTALL_DIR/deploy/skygenpanel" "$cli_temp"
  mv -f -- "$cli_temp" "$CLI_PATH"
  trap - EXIT
  # The backup script and its units travel with the CLI, and for the same
  # reason: `git reset --hard` above restores every tracked file in the
  # checkout, so anything installed OUTSIDE it — /usr/local/bin, /etc/systemd —
  # keeps whatever version it had until something copies the new one. A backup
  # script frozen at the version of the day it was installed is exactly the kind
  # of thing nobody notices until the restore.
  if [ -f "$INSTALL_DIR/deploy/skygenpanel-backup" ]; then
    install -m 0755 "$INSTALL_DIR/deploy/skygenpanel-backup" "$BACKUP_CLI_PATH"
    install -m 0644 "$INSTALL_DIR/deploy/skygenpanel-backup.service" /etc/systemd/system/
    install -m 0644 "$INSTALL_DIR/deploy/skygenpanel-backup.timer" /etc/systemd/system/
    # The OnFailure= target the backup unit now names: without it, systemd
    # would log "unit not found" on the very failure it exists to report.
    [ ! -f "$INSTALL_DIR/deploy/skygenpanel-backup-failure.service" ] \
      || install -m 0644 "$INSTALL_DIR/deploy/skygenpanel-backup-failure.service" /etc/systemd/system/
    systemctl daemon-reload
    systemctl enable --now skygenpanel-backup.timer >/dev/null 2>&1 \
      || warn "Could not enable the backup timer."
  fi
  # The updater travels the same way, with one difference: its timer is
  # installed but not enabled. An install updates itself only after someone
  # runs `skygenpanel auto-update enable` on it. The script goes in by rename,
  # never in place: it may be the very process running this update.
  if [ -f "$INSTALL_DIR/deploy/skygenpanel-autoupdate" ]; then
    [ ! -L "$AUTOUPDATE_CLI_PATH" ] || die "Refusing symbolic-link path: $AUTOUPDATE_CLI_PATH"
    install -m 0755 "$INSTALL_DIR/deploy/skygenpanel-autoupdate" "${AUTOUPDATE_CLI_PATH}.new.$$"
    mv -f -- "${AUTOUPDATE_CLI_PATH}.new.$$" "$AUTOUPDATE_CLI_PATH"
    install -m 0644 "$INSTALL_DIR/deploy/skygenpanel-autoupdate.service" /etc/systemd/system/
    install -m 0644 "$INSTALL_DIR/deploy/skygenpanel-autoupdate.timer" /etc/systemd/system/
    systemctl daemon-reload
  fi
  log "Updating backend dependencies"
  ( cd "$INSTALL_DIR/backend" && npm ci --omit=dev )
  log "Rebuilding frontend"
  ( cd "$INSTALL_DIR/frontend" && npm ci --include=dev && npm run build )
  ensure_env_defaults
  chown -R root:root "$INSTALL_DIR"
  chmod 600 "$ENV_FILE"
  log "Restarting service"
  systemctl restart "$SERVICE_NAME"
  log "Waiting for the panel to answer"
  wait_healthy || die "The panel did not come back healthy after the update. See 'skygenpanel logs'."
  log "Update complete: $(cmd_version)"
}

cmd_expose() {
  need_root
  validate_install_dir
  set_env APP_HOST "0.0.0.0"
  # A directly reachable listener must not believe forwarded headers: a client
  # could otherwise forge its source address and escape every rate limit.
  set_env TRUST_PROXY "0"
  local port portal; port="$(app_port)"; portal="$(portal_port)"
  log "Panel will bind to 0.0.0.0:${port} (reachable from the network)."
  log "Customer portal will bind to 0.0.0.0:${portal}."
  log "Proxy headers are now untrusted (TRUST_PROXY=0)."
  warn "Anyone on your network can now reach the panel. Ensure a strong admin password and a firewall."
  systemctl restart "$SERVICE_NAME"
  log "Done."
}

cmd_unexpose() {
  need_root
  validate_install_dir
  set_env APP_HOST "127.0.0.1"
  # Back to loopback-only, so the reverse proxy or tunnel in front is again the
  # single trusted hop that carries the real client address.
  set_env TRUST_PROXY "1"
  log "Panel restricted to localhost (127.0.0.1)."
  log "Proxy headers from the local reverse proxy are trusted again (TRUST_PROXY=1)."
  systemctl restart "$SERVICE_NAME"
  log "Done."
}

cmd_restart() { need_root; systemctl restart "$SERVICE_NAME"; log "Restarted."; }
cmd_start()   { need_root; systemctl start "$SERVICE_NAME"; log "Started."; }
cmd_stop()    { need_root; systemctl stop "$SERVICE_NAME"; log "Stopped."; }
cmd_status()  { systemctl status "$SERVICE_NAME" --no-pager; }
cmd_version() {
  local version commit
  [ -f "$INSTALL_DIR/package.json" ] || die "Package manifest not found: $INSTALL_DIR/package.json"
  version="$(node -p "require('${INSTALL_DIR}/package.json').version")"
  commit="$(git -C "$INSTALL_DIR" rev-parse --short=12 HEAD 2>/dev/null || echo unknown)"
  printf 'TR69 Controle v%s (%s)\n' "$version" "$commit"
}
cmd_logs() {
  local lines="${1:-100}"
  [[ "$lines" =~ ^[0-9]+$ ]] || die "Log line count must be a positive integer."
  journalctl -u "$SERVICE_NAME" -n "$lines" -f
}

cmd_reset_password() {
  need_root
  validate_install_dir
  local user="${1:-}" pass="${RESET_PASSWORD:-}"
  [ -n "$user" ] || die "Usage: skygenpanel reset-password <username>  (password prompted, or from RESET_PASSWORD)"
  # Senha como argumento aparece em `ps` e no histórico do shell: recusa e
  # aponta o caminho certo em vez de aceitar em silêncio o uso antigo.
  [ -z "${2:-}" ] || die "Refusing a password given as an argument (visible in ps and shell history). Omit it to be prompted, or set RESET_PASSWORD."
  if [ -z "$pass" ]; then
    read -r -s -p "New password: " pass
    printf '\n'
  fi
  [ -n "$pass" ] || die "Password cannot be empty."
  ( cd "$INSTALL_DIR/backend" && RESET_PASSWORD="$pass" node scripts/reset-password.js "$user" )
}

# Para quem perdeu o celular e os códigos de recuperação e que a tela da equipe
# não pode destravar (o último dono, quem trabalha em vários provedores, quem
# opera a plataforma). O nome não é segredo, então vai por argumento.
cmd_reset_mfa() {
  need_root
  validate_install_dir
  local user="${1:-}"
  [ -n "$user" ] || die "Usage: skygenpanel reset-mfa <username>"
  ( cd "$INSTALL_DIR/backend" && node scripts/reset-mfa.js "$user" )
}

# A chave entra por VARIÁVEL DE AMBIENTE, nunca por argumento: argv aparece em
# `ps` para qualquer usuário da máquina e fica no histórico do shell. É a mesma
# regra de `reset-password` acima, e aqui pesa mais — o segredo é a chave mestra
# que abre senha de portal, senha de WiFi e todo token de integração.
cmd_rotate_key() {
  need_root
  validate_install_dir
  local modo="${1:-}"
  case "$modo" in
    ''|--dry-run) ;;
    *) die "Usage: skygenpanel rotate-key [--dry-run]" ;;
  esac
  ( cd "$INSTALL_DIR/backend" && node scripts/rotate-secret-key.js $modo )
}

cmd_auto_update() {
  [ -x "$AUTOUPDATE_CLI_PATH" ] \
    || die "Auto-update is not installed at $AUTOUPDATE_CLI_PATH. Run 'skygenpanel update' once."
  "$AUTOUPDATE_CLI_PATH" "$@"
}

# Delegated rather than reimplemented: the timer runs the same script with the
# same arguments, so an operator who types this by hand and the machine that
# runs it at 03:17 are doing exactly the same thing. Two copies of "how a backup
# is taken" would be two answers on the day they disagree.
cmd_backup() {
  local verbo="${1:-run}"
  [ -x "$BACKUP_CLI_PATH" ] \
    || die "Backup script not installed at $BACKUP_CLI_PATH. Run 'skygenpanel update'."
  shift || true
  "$BACKUP_CLI_PATH" "$verbo" "$@"
}

usage() {
  cat <<EOF
skygenpanel — manage the TR69 Controle service

Usage: skygenpanel <command> [args]

Commands:
  update [vX.Y.Z]             Pull latest code (or that release), rebuild, restart
  auto-update <cmd>           enable | disable | status | check | run — follow new
                              releases on their own (off until enabled)
  expose                      Bind to 0.0.0.0 (allow network access) + restart
  unexpose                    Bind to 127.0.0.1 (localhost only) + restart
  restart | start | stop      Control the systemd service
  status                      Show service status
  version                     Show installed version and Git revision
  logs [N]                    Follow the last N log lines (default 100)
  reset-password <u>          Reset password (prompts securely, or RESET_PASSWORD)
  reset-mfa <u>               Turn off two-step login for someone who lost it
  backup [verify]             Take a backup now, or report the newest one
  backup upload | restore …   Send the encrypted copy to the external bucket, or
                              test-restore one (--from-s3 <key|latest> --private-key <file>)
  rotate-key [--dry-run]      Rewrite stored secrets with the live SECRET_BOX_KEY
  help                        Show this help
EOF
}

case "${1:-help}" in
  update)          cmd_update "${2:-}" ;;
  auto-update)     shift; cmd_auto_update "${@:-status}" ;;
  expose)          cmd_expose ;;
  unexpose)        cmd_unexpose ;;
  restart)         cmd_restart ;;
  start)           cmd_start ;;
  stop)            cmd_stop ;;
  status)          cmd_status ;;
  version|-v|--version) cmd_version ;;
  logs)            cmd_logs "${2:-100}" ;;
  reset-password)  cmd_reset_password "${2:-}" "${3:-}" ;;
  reset-mfa)       cmd_reset_mfa "${2:-}" ;;
  backup)          shift; cmd_backup "${@:-run}" ;;
  rotate-key)      cmd_rotate_key "${2:-}" ;;
  help|-h|--help)  usage ;;
  *)               warn "Unknown command: $1"; usage; exit 1 ;;
esac
