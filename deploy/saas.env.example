# Variáveis da edição SaaS. Copie para deploy/saas.env e preencha.
# Nada aqui tem valor padrão aceitável em produção: os três segredos são
# conferidos no boot e o processo se recusa a subir com um fraco.

# --- Postgres do compose (ignorado quando DATABASE_URL aponta para fora) ---
POSTGRES_USER=skygp
POSTGRES_PASSWORD=
POSTGRES_DB=skygp

# --- Nomes -----------------------------------------------------------------
# O painel de cada provedor vive em <slug>.TENANT_BASE_DOMAIN; o portal do
# assinante em <slug>.PORTAL_BASE_DOMAIN. O próprio TENANT_BASE_DOMAIN (e o
# www dele) é a porta de entrada da plataforma: só o cadastro vive ali.
TENANT_BASE_DOMAIN=painel.exemplo.com
PORTAL_BASE_DOMAIN=portal.exemplo.com
CORS_ORIGINS=https://painel.exemplo.com

# --- Segredos (openssl rand -hex 48 para cada um) --------------------------
JWT_SECRET=
PORTAL_JWT_SECRET=
# Cifra o que um operador pode ler de volta (credencial NBI, senha de portal).
# Separado do JWT_SECRET para poder trocar sessão sem perder esses dados.
SECRET_BOX_KEY=
# Quem coleta as métricas em /api/platform/metrics. Vazio = só o console.
METRICS_TOKEN=

# --- Sessões ---------------------------------------------------------------
JWT_EXPIRES_IN=1h
REFRESH_TOKEN_EXPIRES_IN=7d

# --- E-mail (opcional) ------------------------------------------------------
# Sem estas duas não há envio, e o link do convite continua saindo na resposta
# da API para quem convidou entregar como quiser.
SMTP_URL=
MAIL_FROM=SkyGenPanel <nao-responda@exemplo.com>

# --- Log -------------------------------------------------------------------
# text (uma linha legível) ou json (um objeto por linha, para o coletor).
LOG_FORMAT=json
# debug, info, warn ou error.
LOG_LEVEL=info
